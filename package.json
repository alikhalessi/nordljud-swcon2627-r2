{
  "name": "nordljud-core-sdd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:sources": "vitest run tests/unit/source-contract.test.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts tests/integration/ownership.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:account": "playwright test --config playwright.account.config.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@supabase/supabase-js": "2.118.0",
    "@supabase/ssr": "0.12.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vitest": "5.0.5",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@playwright/test": "1.64.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3"
  }
}
