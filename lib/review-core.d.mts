export type ReviewLevel="A2"|"B1"|"B2"|"C1";
export type ReviewSense={level:ReviewLevel;verb:string;meaning:string};
export type ReviewItem=ReviewSense & {firstRequestedOn:string;dueOn:string;lastReviewedOn:string|null;reviewedCount:number};
export type DailyCompletion={level:ReviewLevel;lessonOn:string;algorithmVersion:string};
export type ReviewResult=ReviewSense & {questionId:string;correct:boolean};
export type ReviewSession={id:string;windowDays:7|14;reviewedOn:string;score:number;total:number;results:ReviewResult[]};
export type ReviewSnapshot={version:1;completions:DailyCompletion[];reminders:ReviewItem[];sessions:ReviewSession[]};
export type ReviewQuestion={id:string;kind:"meaning"|"form"|"cloze";title:string;prompt:string;context:string;choices:string[];answer:string;explanation:string;level:ReviewLevel;verb:string;meaning:string;reviewId:string};
export const GUEST_REVIEW_VERSION:1;
export const GUEST_REVIEW_KEY:string;
export const DAILY_ARCHIVE_START:string;
export const DAILY_SELECTION_VERSION:string;
export const EMPTY_GUEST_SNAPSHOT:ReviewSnapshot;
export const LEVELS:ReviewLevel[];
export function isValidDay(day:unknown):boolean;
export function addLocalDays(day:string,delta:number):string;
export function dayDistance(start:string,end:string):number;
export function isSense(s:unknown):s is ReviewSense;
export function senseKey(s:ReviewSense):string;
export function loadGuestSnapshot(raw:string|null):ReviewSnapshot;
export function toggleDailyCompletion(snapshot:ReviewSnapshot,level:ReviewLevel,lessonOn:string):ReviewSnapshot;
export function addReminder(snapshot:ReviewSnapshot,sense:ReviewSense,today:string):ReviewSnapshot;
export function removeReminder(snapshot:ReviewSnapshot,sense:ReviewSense):ReviewSnapshot;
export function snoozeReminder(snapshot:ReviewSnapshot,sense:ReviewSense,today:string,days:2|7|14):ReviewSnapshot;
export function markReviewed(snapshot:ReviewSnapshot,sense:ReviewSense,today:string):ReviewSnapshot;
export function canOfferReview(item:ReviewItem,windowDays:7|14,today:string):boolean;
export function appendReviewSession(snapshot:ReviewSnapshot,session:ReviewSession):ReviewSnapshot;
export function assembleReviewQuestions(reminders:ReviewItem[],pools:Partial<Record<ReviewLevel,Array<{id:string;verb:string;meaning:string;forms:Record<string,{word?:string;sv?:string;en?:string}>}>>>,today:string,windowDays:7|14,sessions?:ReviewSession[]):ReviewQuestion[];
